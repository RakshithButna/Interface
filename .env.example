# Model API key -- used by the DISCOVERY run only. Replay never reads this file.
#
# Set ANY ONE of the keys below. The provider is auto-detected from whichever
# key is present, so there is nothing else to configure.

# --- Anthropic ---------------------------------------------------------------
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5          # default; any Claude model id works

# --- Groq (free tier; the documented default for this project's demo) --------
# https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me
# GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI ------------------------------------------------------------------
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1

# --- OpenRouter / Together ---------------------------------------------------
# OPENROUTER_API_KEY=sk-or-...
# TOGETHER_API_KEY=...

# --- Any other OpenAI-compatible endpoint (vLLM, Ollama, LM Studio) ----------
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_API_KEY=ollama
# OPENAI_COMPATIBLE_MODEL=qwen2.5:32b

# Force a specific provider when several keys are present (optional).
# LLM_PROVIDER=anthropic

# --- Target app --------------------------------------------------------------
TARGET_BASE_URL=http://127.0.0.1:4173
OPERATOR_CONSOLE_PORT=4180

# Demo-app operator credentials. Synthetic; not a real secret. Override if you
# change them in apps/memberfirst-core/tenants.ts.
# MFC_OPERATOR_USER=svc_agent
# MFC_OPERATOR_PASSWORD=demo-only-not-a-real-secret
