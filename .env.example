# LLM provider used for the DISCOVERY run only. Replay never reads this.
# Free key: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=moonshotai/kimi-k2-instruct

# Optional alternates - the agent loop is provider-agnostic.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-replace_me
# ANTHROPIC_MODEL=claude-sonnet-5

# Target app
TARGET_BASE_URL=http://127.0.0.1:4173
OPERATOR_CONSOLE_PORT=4180
